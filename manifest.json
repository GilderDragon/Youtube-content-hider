{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
	"default_icon": {
	  "16": "resources/icons/icon16.png",
	  "32": "resources/icons/icon32.png",
	  "48": "resources/icons/icon48.png",
	  "128": "resources/icons/icon128.png"
	}
  },
  "icons": {
	"16": "resources/icons/icon16.png",
	"32": "resources/icons/icon32.png",
	"48": "resources/icons/icon48.png",
    "128": "resources/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": [
		  "src/config.js",
		  "src/canvas-generator.js",
		  "src/dom-filter.js",
		  "src/content.js"
	  ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
	{
	  "resources": [
		  "resources/backgrounds/bg_regular.png",
		  "resources/backgrounds/bg_shorts.png",
		  "resources/fonts/PreviewFont.otf"
	  ],
	  "matches": ["https://*.youtube.com/*"]
	}
  ]
}

